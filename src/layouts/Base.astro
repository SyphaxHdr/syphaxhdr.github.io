---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Entete from '../components/Entete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import Fenetres from '../components/Fenetres.astro';
import {
  adresse,
  LANGUES,
  sansLangue,
  textes,
  type Face,
  type FaceProjet,
  type Langue,
} from '../lib/contenu';

interface Props {
  titre: string;
  // Le résumé de la page pour les moteurs de recherche ; sinon, celui du site.
  description?: string;
  face: Face;
  langue: Langue;
  // Sur une page CV : le sélecteur Production / DevOps remplace le bouton CV.
  cvFace?: FaceProjet;
}

const { titre, description, face, langue, cvFace } = Astro.props;
const t = await textes(langue);
// La même page dans chaque langue, pour les moteurs de recherche.
const chemin = sansLangue(Astro.url.pathname);
const versions = LANGUES.map((l) => ({ langue: l, href: new URL(adresse(l, chemin), Astro.site).href }));
// L'aperçu affiché quand on partage un lien du site (réseaux sociaux, messageries).
const resume = description ?? t.descriptionSite;
const adressePage = new URL(Astro.url.pathname, Astro.site).href;
const apercu = new URL('/apercu.png', Astro.site).href;
---

<html lang={langue} data-face={face}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
    <meta name="description" content={resume} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Syphax Hadri · Portfolio" />
    <meta property="og:locale" content={langue === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:url" content={adressePage} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={resume} />
    <meta property="og:image" content={apercu} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    {versions.map((v) => <link rel="alternate" hreflang={v.langue} href={v.href} />)}
    <link rel="alternate" hreflang="x-default" href={versions[0].href} />
    <Font cssVariable="--font-instrument-sans" preload />
    <Font cssVariable="--font-fraunces" />
    <Font cssVariable="--font-jetbrains-mono" />
    <title>{titre}</title>
  </head>
  <body>
    <a class="aller-au-contenu" href="#contenu">{t.allerAuContenu}</a>
    <Entete langue={langue} cvFace={cvFace} />
    <main class="conteneur principal" id="contenu">
      <slot />
    </main>
    <PiedDePage langue={langue} />
    <Fenetres langue={langue} />
  </body>
</html>
